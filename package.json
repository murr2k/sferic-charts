{
  "name": "sferic-charts",
  "version": "0.2.1",
  "description": "GPU-accelerated WebGL2 charting library for the browser: real-time, large-data, 3D and dashboard charts",
  "keywords": [
    "chart",
    "charts",
    "webgl",
    "webgl2",
    "gpu",
    "real-time",
    "visualization",
    "dataviz",
    "heatmap",
    "3d",
    "dashboard"
  ],
  "author": "Murray Kopit",
  "license": "MIT",
  "homepage": "https://github.com/murr2k/sferic-charts#readme",
  "bugs": {
    "url": "https://github.com/murr2k/sferic-charts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murr2k/sferic-charts.git"
  },
  "type": "module",
  "main": "dist/sferic.umd.cjs",
  "module": "dist/sferic.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/sferic.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/sferic.umd.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json && node scripts/fix-dts.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "snap": "node scripts/snap.mjs",
    "bench": "node scripts/bench.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "verify:package": "node scripts/verify-package.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build:lib && npm run verify:package",
    "test:browser": "node scripts/robustness.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^25.14.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
