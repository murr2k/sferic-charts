{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "declaration": true,
    "declarationDir": "dist/types",
    "noEmit": true,
    "paths": { "sferic-charts": ["./src/index.ts"] }
  },
  "include": ["src", "gallery", "site"]
}
